{
  "buildCommand": "pnpm --filter @workspace/juniper run build",
  "outputDirectory": "artifacts/juniper/dist",
  "installCommand": "pnpm install",
  "framework": null,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "juniper-api-server.vercel.app"
        }
      ],
      "destination": "https://www.juniperplan.com/",
      "permanent": false
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "juniper-api-server.vercel.app"
        }
      ],
      "destination": "https://www.juniperplan.com/:path",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-sync",
      "schedule": "0 9 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/invite/partner/:token",
      "destination": "/api/invite-preview?token=:token"
    },
    {
      "source": "/((?!api/|.*\\..+).*)",
      "destination": "/index.html"
    }
  ]
}
